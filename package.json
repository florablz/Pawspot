{
  "name": "Pawspot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.7",
    "nuxt": "^4.4.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "bcrypt@6.0.0": true,
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
